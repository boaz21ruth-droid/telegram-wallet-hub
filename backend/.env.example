# ── 必填 ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_wallet
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_JWT_SECRET=replace-with-another-random-string-different-from-jwt-secret
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# ── 服务器 ─────────────────────────────────────────────────────────────────────
PORT=7001

# ── JWT 有效期 ─────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=2h
ADMIN_JWT_EXPIRES_IN=8h

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# ── 管理员 Bootstrap 账号（服务启动时自动 upsert）──────────────────────────────
# 生产环境必须修改密码；开发环境默认 admin / admin123456
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123456
ADMIN_BOOTSTRAP_DISPLAY_NAME=Local Admin
ADMIN_BOOTSTRAP_ROLE=SUPER_ADMIN

# ── 提现审核阈值 ───────────────────────────────────────────────────────────────
WITHDRAW_MANUAL_REVIEW_THRESHOLD=1000

# ── 链/网络开关 ────────────────────────────────────────────────────────────────
# 逗号分隔的禁用网络列表；留空则开启全部；默认关闭 TON 主网（仅显示 TRC20）
# 可选值: TON | TRC20
# 示例: DISABLED_NETWORKS=TON,TRC20  → 全关; DISABLED_NETWORKS=  → 全开
DISABLED_NETWORKS=TON

# ── TON 链 ─────────────────────────────────────────────────────────────────────
TONCENTER_API_URL=https://toncenter.com/api/v2
TONCENTER_API_KEY=
USDT_JETTON_MASTER_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# 24 词 BIP39 助记词，空格分隔
TON_HOT_WALLET_MNEMONIC=

# ── TRC20（Tron）链 ────────────────────────────────────────────────────────────
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRC20_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# BIP44 助记词；index 0 = 热钱包（提现），index 1+ = 充值地址
TRC20_HOT_WALLET_MNEMONIC=
