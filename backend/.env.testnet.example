# ── 必填 ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_wallet
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_JWT_SECRET=replace-with-another-random-string-different-from-jwt-secret
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# ── 服务器 ─────────────────────────────────────────────────────────────────────
PORT=7001

# ── JWT 有效期 ─────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=2h
ADMIN_JWT_EXPIRES_IN=8h

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# ── 管理员 Bootstrap 账号 ───────────────────────────────────────────────────────
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123456
ADMIN_BOOTSTRAP_DISPLAY_NAME=Testnet Admin
ADMIN_BOOTSTRAP_ROLE=SUPER_ADMIN

# ── 提现审核阈值 ───────────────────────────────────────────────────────────────
WITHDRAW_MANUAL_REVIEW_THRESHOLD=1000

# ── TON 测试网（testnet.toncenter.com）────────────────────────────────────────
TONCENTER_API_URL=https://testnet.toncenter.com/api/v2
TONCENTER_API_KEY=
# 测试网需自行部署 Jetton 合约或使用已知测试网地址，填入后替换此占位符
USDT_JETTON_MASTER_ADDRESS=<TON_TESTNET_JETTON_MASTER_ADDRESS>
# 测试网助记词（资金少，风险低，但仍不要入 git）
TON_HOT_WALLET_MNEMONIC=

# ── TRC20 Tron Nile 测试网（nile.trongrid.io）─────────────────────────────────
TRONGRID_API_URL=https://nile.trongrid.io
TRONGRID_API_KEY=
# Nile 测试网 USDT 合约（从 Nile Faucet 获取最新地址）
TRC20_USDT_CONTRACT=<NILE_TESTNET_USDT_CONTRACT>
# 测试网助记词（同上，不要入 git）
TRC20_HOT_WALLET_MNEMONIC=
