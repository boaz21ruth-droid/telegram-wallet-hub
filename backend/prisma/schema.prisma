generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  OPS_REVIEWER
  FINANCE_OPERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum WalletAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum JournalType {
  DEPOSIT
  TRANSFER
  WITHDRAWAL_FREEZE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_CONFIRM
  ADJUSTMENT
  SWAP
  FIAT_ONRAMP
  STAKING_LOCK
  STAKING_UNLOCK
  STAKING_YIELD
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum TransferStatus {
  SUCCESS
  FAILED
}

enum ReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawStatus {
  PENDING_REVIEW
  READY_FOR_SIGNING
  REJECTED
  CANCELED
  SIGNED
  CONFIRMED
  FAILED
}

enum SwapStatus {
  COMPLETED
  FAILED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum KycIdType {
  ID_CARD
  PASSPORT
  DRIVER_LICENSE
}

model User {
  id                 String          @id @default(cuid())
  telegramUserId     String          @unique
  username           String?
  firstName          String?
  lastName           String?
  photoUrl           String?
  role               UserRole        @default(USER)
  status             UserStatus      @default(ACTIVE)
  kycStatus          KycStatus       @default(UNVERIFIED)
  authSessions       AuthSession[]
  walletAccounts     WalletAccount[]
  outgoingTransfers  TransferOrder[] @relation("OutgoingTransfers")
  incomingTransfers  TransferOrder[] @relation("IncomingTransfers")
  withdrawOrders     WithdrawOrder[] @relation("UserWithdrawOrders")
  depositOrders      DepositOrder[]
  swapOrders         SwapOrder[]
  fiatOnrampOrders   FiatOnrampOrder[]
  stakingOrders      StakingOrder[]
  kycApplication     KycApplication?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model AdminAccount {
  id                 String          @id @default(cuid())
  username           String          @unique
  passwordHash       String
  displayName        String?
  role               AdminRole       @default(SUPER_ADMIN)
  isActive           Boolean         @default(true)
  sessions           AdminSession[]
  reviewedWithdraws           WithdrawOrder[]    @relation("ReviewedAdminWithdrawOrders")
  reviewedKycApplications     KycApplication[]   @relation("ReviewedKycApplications")
  reviewedFiatOrders          FiatOnrampOrder[]  @relation("ReviewedFiatOrders")
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
}

model AdminSession {
  id          String       @id @default(cuid())
  adminId     String
  admin       AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([adminId])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress        String?
  userAgent        String?
  telegramAuthDate DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model WalletAccount {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCode        String
  network          String
  availableBalance Decimal             @default(0) @db.Decimal(36, 18)
  frozenBalance    Decimal             @default(0) @db.Decimal(36, 18)
  stakedBalance    Decimal             @default(0) @db.Decimal(36, 18)
  status           WalletAccountStatus @default(ACTIVE)
  addresses        WalletAddress[]
  ledgerEntries    LedgerEntry[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, assetCode, network])
  @@index([assetCode, network])
}

model WalletAddress {
  id                  String        @id @default(cuid())
  walletAccountId     String
  walletAccount       WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  address             String        @unique
  memo                String?
  isPrimary           Boolean       @default(false)
  lastScannedLt       String        @default("0")
  jettonWalletAddress String?
  createdAt           DateTime      @default(now())
}

model LedgerJournal {
  id           String        @id @default(cuid())
  type         JournalType
  referenceType String
  referenceId  String
  description  String?
  metadata     Json?
  status       JournalStatus @default(POSTED)
  entries      LedgerEntry[]
  createdAt    DateTime      @default(now())

  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id                String               @id @default(cuid())
  journalId         String
  journal           LedgerJournal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  walletAccountId   String?
  walletAccount     WalletAccount?       @relation(fields: [walletAccountId], references: [id], onDelete: SetNull)
  ledgerAccountCode String
  direction         LedgerEntryDirection
  assetCode         String
  network           String
  amount            Decimal              @db.Decimal(36, 18)
  createdAt         DateTime             @default(now())

  @@index([walletAccountId])
  @@index([ledgerAccountCode])
}

model TransferOrder {
  id         String         @id @default(cuid())
  fromUserId String
  fromUser   User           @relation("OutgoingTransfers", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User           @relation("IncomingTransfers", fields: [toUserId], references: [id], onDelete: Cascade)
  assetCode  String
  network    String
  amount     Decimal        @db.Decimal(36, 18)
  fee        Decimal        @default(0) @db.Decimal(36, 18)
  bizNo      String
  status     TransferStatus @default(SUCCESS)
  note       String?
  journalId  String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fromUserId, bizNo])
  @@index([toUserId, createdAt])
}

model WithdrawOrder {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation("UserWithdrawOrders", fields: [userId], references: [id], onDelete: Cascade)
  assetCode            String
  network              String
  toAddress            String
  amount               Decimal        @db.Decimal(36, 18)
  fee                  Decimal        @db.Decimal(36, 18)
  totalAmount          Decimal        @db.Decimal(36, 18)
  note                 String?
  requiresManualReview Boolean        @default(false)
  reviewStatus         ReviewStatus   @default(PENDING)
  status               WithdrawStatus @default(PENDING_REVIEW)
  reviewerId           String?
  reviewer             AdminAccount?  @relation("ReviewedAdminWithdrawOrders", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerNote         String?
  reviewedAt           DateTime?
  txHash               String?
  freezeJournalId      String?        @unique
  releaseJournalId     String?        @unique
  confirmJournalId     String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, reviewStatus])
}

model DepositOrder {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCode   String
  network     String
  fromAddress String?
  amount      Decimal       @db.Decimal(36, 18)
  txHash      String?       @unique
  note        String?
  status      DepositStatus @default(PENDING)
  journalId   String?       @unique
  creditedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model SwapOrder {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromAssetCode String
  fromNetwork   String
  fromAmount    Decimal    @db.Decimal(36, 18)

  toAssetCode   String
  toNetwork     String
  toAmount      Decimal    @db.Decimal(36, 18)

  midRate       Decimal    @db.Decimal(36, 18)
  feeRate       Decimal    @db.Decimal(36, 18)
  feeAmount     Decimal    @db.Decimal(36, 18)

  bizNo         String
  status        SwapStatus @default(COMPLETED)
  journalId     String?    @unique
  note          String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, bizNo])
  @@index([userId, createdAt])
  @@index([status])
}

model DepositAddressCounter {
  id        String @id   // network name: "TON" or "TRC20"
  nextIndex Int    @default(1)
}

// ── Fiat On-ramp ──────────────────────────────────────────────────────────────

enum FiatOnrampStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  UNDER_REVIEW
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

model FiatOnrampOrder {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  fiatCurrency      String
  fiatAmount        Decimal          @db.Decimal(36, 6)

  assetCode         String
  network           String
  cryptoAmount      Decimal          @db.Decimal(36, 18)
  grossAmount       Decimal          @db.Decimal(36, 18)
  feeAmount         Decimal          @db.Decimal(36, 18)

  exchangeRate      Decimal          @db.Decimal(36, 6)
  feeRate           Decimal          @db.Decimal(36, 6)

  paymentMethodCode String?
  paymentAccountRef String?
  paymentProofPath  String?
  paymentNote       String?

  reviewerId        String?
  reviewer          AdminAccount?    @relation("ReviewedFiatOrders", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerNote      String?
  reviewedAt        DateTime?

  status            FiatOnrampStatus @default(PENDING_PAYMENT)
  journalId         String?          @unique
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model FiatPaymentMethod {
  id            String   @id @default(cuid())
  code          String   @unique
  displayName   String
  accountName   String
  accountNumber String
  qrCodePath    String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Staking ───────────────────────────────────────────────────────────────────

enum StakingProductType {
  FLEXIBLE
  FIXED
}

enum StakingOrderStatus {
  ACTIVE
  REDEEMING
  REDEEMED
}

model StakingProduct {
  id          String             @id @default(cuid())
  name        String
  description String?
  assetCode   String
  network     String
  productType StakingProductType
  minAmount   Decimal            @db.Decimal(36, 18)
  maxAmount   Decimal?           @db.Decimal(36, 18)
  totalCap    Decimal?           @db.Decimal(36, 18)
  lockDays    Int                @default(0)
  currentApy  Decimal            @default(0.042) @db.Decimal(10, 6)
  isActive    Boolean            @default(true)
  orders      StakingOrder[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model StakingOrder {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             StakingProduct     @relation(fields: [productId], references: [id])

  assetCode           String
  network             String
  principal           Decimal            @db.Decimal(36, 18)
  accruedYield        Decimal            @default(0) @db.Decimal(36, 18)
  lastYieldAt         DateTime?
  nextYieldAt         DateTime?
  maturesAt           DateTime?
  redeemRequestedAt   DateTime?

  status              StakingOrderStatus @default(ACTIVE)
  lockJournalId       String?            @unique
  unlockJournalId     String?            @unique
  yieldRecords        StakingYieldRecord[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, status])
  @@index([status, nextYieldAt])
}

model StakingYieldRecord {
  id             String       @id @default(cuid())
  stakingOrderId String
  order          StakingOrder @relation(fields: [stakingOrderId], references: [id])
  userId         String
  assetCode      String
  network        String
  grossYield     Decimal      @db.Decimal(36, 18)
  platformFee    Decimal      @db.Decimal(36, 18)
  netYield       Decimal      @db.Decimal(36, 18)
  journalId      String       @unique
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())

  @@index([stakingOrderId])
}

model KycApplication {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName       String
  idType         KycIdType
  idNumber       String
  country        String
  birthDate      DateTime      @db.Date
  frontImagePath String
  backImagePath  String?
  reviewerId     String?
  reviewer       AdminAccount? @relation("ReviewedKycApplications", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerNote   String?
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([reviewerId])
}

model AuditLog {
  id           String         @id @default(cuid())
  actorType    AuditActorType
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime       @default(now())

  @@index([resourceType, resourceId])
}
